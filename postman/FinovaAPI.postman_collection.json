{
	"info": {
		"name": "FinovaAPI",
		"description": "Coleccion de endpoints para la API REST de FINOVA - Sistema de Costeo y Optimizacion Financiera",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "finova-dev"
	},
	"item": [
		{
			"name": "Autenticacion",
			"description": "Endpoints de autenticacion y gestion de sesion",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						},
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
						},
						"description": "Inicia sesion y devuelve un token JWT"
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"url": {
							"raw": "{{baseUrl}}/api/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "logout"]
						},
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"description": "Cierra la sesion activa e invalida el token"
					}
				},
				{
					"name": "Obtener perfil actual",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "me"]
						},
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"description": "Obtiene la informacion del usuario autenticado"
					}
				}
			]
		},
		{
			"name": "Inventario",
			"description": "CRUD completo del modulo de inventario",
			"item": [
				{
					"name": "Listar inventario",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/inventario?categoria=&busqueda=",
							"host": ["{{baseUrl}}"],
							"path": ["api", "inventario"],
							"query": [
								{ "key": "categoria", "value": "", "description": "Filtrar por categoria" },
								{ "key": "busqueda", "value": "", "description": "Buscar por nombre o codigo" }
							]
						},
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"description": "Lista todos los productos del inventario con filtros opcionales"
					}
				},
				{
					"name": "Obtener producto",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/inventario/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "inventario", "1"]
						},
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"description": "Obtiene un producto por su ID"
					}
				},
				{
					"name": "Crear producto",
					"request": {
						"method": "POST",
						"url": {
							"raw": "{{baseUrl}}/api/inventario",
							"host": ["{{baseUrl}}"],
							"path": ["api", "inventario"]
						},
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"codigo\": \"MP-005\",\n  \"nombre\": \"Tela Seda\",\n  \"categoria\": \"Materia Prima\",\n  \"cantidad\": 200,\n  \"costoUnitario\": 25.00,\n  \"stockMinimo\": 50\n}"
						},
						"description": "Crea un nuevo producto en el inventario"
					}
				},
				{
					"name": "Actualizar producto",
					"request": {
						"method": "PUT",
						"url": {
							"raw": "{{baseUrl}}/api/inventario/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "inventario", "1"]
						},
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"codigo\": \"MP-001\",\n  \"nombre\": \"Tela Algodon Premium\",\n  \"categoria\": \"Materia Prima\",\n  \"cantidad\": 450,\n  \"costoUnitario\": 15.00,\n  \"stockMinimo\": 100\n}"
						},
						"description": "Actualiza un producto existente por su ID"
					}
				},
				{
					"name": "Eliminar producto",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{baseUrl}}/api/inventario/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "inventario", "1"]
						},
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"description": "Elimina un producto del inventario"
					}
				},
				{
					"name": "Estadisticas de inventario",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/inventario/stats",
							"host": ["{{baseUrl}}"],
							"path": ["api", "inventario", "stats"]
						},
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"description": "Obtiene estadisticas del inventario (total items, valor total, stock bajo)"
					}
				},
				{
					"name": "Listar categorias",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/inventario/categorias",
							"host": ["{{baseUrl}}"],
							"path": ["api", "inventario", "categorias"]
						},
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"description": "Lista las categorias distintas del inventario"
					}
				}
			]
		},
		{
			"name": "Costos",
			"description": "Endpoints para gestion de costos predeterminados",
