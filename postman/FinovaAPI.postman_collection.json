						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"producto\": \"Camisa Deportiva\",\n  \"codigo\": \"CAM-001\",\n  \"cantidad\": 500,\n  \"mpCantEst\": 10,\n  \"mpPrecioEst\": 5.00,\n  \"moCantEst\": 8,\n  \"moPrecioEst\": 12.50,\n  \"ciCantEst\": 5,\n  \"ciPrecioEst\": 8.00,\n  \"mpCantReal\": 12,\n  \"mpPrecioReal\": 6.00,\n  \"moCantReal\": 9,\n  \"moPrecioReal\": 13.00,\n  \"ciCantReal\": 6,\n  \"ciPrecioReal\": 9.50\n}"
						},
						"description": "Guarda un nuevo registro de costos (los totales se calculan en el servidor)"
					}
				},
				{
					"name": "Eliminar costo",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{baseUrl}}/api/costos/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "costos", "1"]
						},
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"description": "Elimina un registro de costo"
					}
				}
			]
		},
		{
