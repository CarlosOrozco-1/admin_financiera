							"path": ["api", "proyecciones", "1"]
						},
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"description": "Obtiene una proyeccion con todos sus items de detalle"
					}
				},
				{
					"name": "Guardar proyeccion",
					"request": {
						"method": "POST",
						"url": {
							"raw": "{{baseUrl}}/api/proyecciones",
							"host": ["{{baseUrl}}"],
							"path": ["api", "proyecciones"]
						},
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"periodo\": \"Proximo trimestre\",\n  \"crecimiento\": 15,\n  \"items\": [\n    {\n      \"inventarioId\": 1,\n      \"codigo\": \"MP-001\",\n      \"nombre\": \"Tela Algodon\",\n      \"categoria\": \"Materia Prima\",\n      \"cantidadActual\": 500,\n      \"cantidadProyectada\": 575,\n      \"costoUnitario\": 12.50\n    },\n    {\n      \"inventarioId\": 2,\n      \"codigo\": \"MP-002\",\n      \"nombre\": \"Hilo Industrial\",\n      \"categoria\": \"Materia Prima\",\n      \"cantidadActual\": 1200,\n      \"cantidadProyectada\": 1380,\n      \"costoUnitario\": 3.75\n    }\n  ]\n}"
						},
						"description": "Guarda una nueva proyeccion con su detalle"
					}
				},
				{
					"name": "Eliminar proyeccion",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{baseUrl}}/api/proyecciones/1",
