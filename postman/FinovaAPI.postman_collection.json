								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"description": "Elimina una proyeccion (el detalle se elimina en cascada)"
					}
				}
			]
		},
		{
			"name": "Auditoria",
			"description": "Endpoints para el modulo de auditoria",
			"item": [
				{
					"name": "Listar auditoria",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/auditoria?modulo=Todos&usuarioId=&fechaDesde=&fechaHasta=&page=1&limit=50",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auditoria"],
							"query": [
								{ "key": "modulo", "value": "Todos" },
								{ "key": "usuarioId", "value": "" },
								{ "key": "fechaDesde", "value": "" },
								{ "key": "fechaHasta", "value": "" },
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "50" }
							]
						},
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"description": "Lista los registros de auditoria con filtros opcionales"
					}
				},
				{
