							"raw": "{{baseUrl}}/api/proyecciones",
							"host": ["{{baseUrl}}"],
							"path": ["api", "proyecciones"]
						},
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"description": "Lista todas las proyecciones guardadas"
